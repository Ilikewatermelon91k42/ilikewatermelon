#include <iostream>
#include <string>
using namespace std;

class student{
    private:
    string name;
    int age;
    char grade;
    public:
    void accept(){
        cout<<"Enter student name: ";
        cin>>name;
        cout<<"Enter student age: ";
        cin>>age;
        cout<<"Enter grade(O/A/B/C/D): ";
        cin>>grade;
    }
    void display(){
        cout<<"\nStudent name: "<<name;
        cout<<"\nStudent age: "<<age;
        cout<<"\nGrade: "<<grade;
    }
    void printograde(){
        if(grade=='o'||grade=='O'){
            display();
        }
    }
};

int main(){
    int n;
    cout<<"Enter number of student: ";
    cin>>n;
    student s[n];
    cout<<"\nEnter student details:\n";
    for(int i=0;i<n;i++){
        cout<<"\nStudent"<<i+1<<endl;
        s[i].accept();
    }
    cout<<"\nStudent who scored grade'O':\n";
    for(int i=0;i<n;i++){
        s[i].printograde();
    }
}
