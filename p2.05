#include <iostream>
#include <string>
using namespace std;

class person{
    private:
    string name;
    string number;
    public:
    void accept(){
        cout<<"Enter person name: ";
        cin>>name;
        cout<<"Enter contact number: ";
        cin>>number;
    }
    void display(){
        cout<<"\nPerson name: "<<name;
        cout<<"\nContact number: "<<number<<endl;
    }
    string getcontact(){
        return number;
    }
};

int main(){
    int n;
    cout<<"Enter number of person: ";
    cin>>n;
    person p[n];
    cout<<"\nEnter person details:\n";
    for(int i=0;i<n;i++){
        cout<<"\nPerson "<<i+1<<endl;
        p[i].accept();
    }
    cout<<"\nAll person details:\n";
    for(int i=0;i<n;i++){
        p[i].display();
    }
    string search;
    cout<<"\nEnter contact number to search:";
    cin>>search;
    bool found=false;
    for(int i=0;i<n;i++){
        if(p[i].getcontact()==search){
            cout<<"\nPerson found:\n";
            p[i].display();
            found=true;
            break;
        }
    }
    if(!found){
        cout<<"Person not found";
    }
}
