#include <iostream>
#include <string>
using namespace std;
class BankAccount{
    private:
    int accNumber;
    string accHolderName;
    float balance;
    public:
    BankAccount(int no,string name,float bal){
        accNumber=no;
        accHolderName=name;
        balance=bal;
    }
    void deposit(float amount){
        balance=balance+amount;
        cout<<"Amount deposited:Rs "<<amount<<endl;
    }
    void withdraw(float amount){
        if(amount<=balance){
            balance=balance-amount;
            cout<<"Amount withdrawn:Rs "<<amount<<endl;
        }else{
            cout<<"Insufficient balance"<<endl;
        }
    }
    void display(){
        cout<<"\n--Bank Account Details--"<<endl;
        cout<<"Account Number: "<<accNumber<<endl;
        cout<<"Account Holder Name: "<<accHolderName<<endl;
        cout<<"Balance: Rs "<<balance<<endl;
    }
};
int main(){
    BankAccount account(1010,"Rahul",10000);
    account.display();
    account.deposit(5000);
    account.display();
    account.withdraw(3000);
    account.display();
}
