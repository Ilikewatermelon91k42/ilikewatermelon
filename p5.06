#include <iostream>
#include <string>
using namespace std;
class Animal{
protected:
    string name;
public:
    Animal(){
        name = "Unknown";
    }
    Animal(string n){
        name = n;
    }
    virtual void sound(){
        cout << name << " makes a sound." << endl;
    }
    virtual void display(){
        cout << "Animal Name: " << name << endl;
    }
};
class Dog : public Animal{
public:
    Dog(string n) : Animal(n){}
    void sound() override{
        cout << name << " says: Woof Woof" << endl;
    }
    void display() override{
        cout << "Animal: Dog" << endl;
        cout << "Name: " << name << endl;
    }
};
class Cat : public Animal{
public:
    Cat(string n) : Animal(n){}
    void sound() override{
        cout << name << " says: Meow Meow" << endl;
    }
    void display() override{
        cout << "Animal: Cat" << endl;
        cout << "Name: " << name << endl;
    }
};
class Cow : public Animal{
public:
    Cow(string n) : Animal(n){}
    void sound() override{
        cout << name << " says: Moo Moo" << endl;
    }
    void display() override{
        cout << "Animal: Cow" << endl;
        cout << "Name: " << name << endl;
    }
};
int main(){
    string dogName, catName, cowName;
    cout << "Enter Dog Name: ";
    cin >> dogName;
    cout << "Enter Cat Name: ";
    cin >> catName;
    cout << "Enter Cow Name: ";
    cin >> cowName;
    Dog d(dogName);
    Cat c(catName);
    Cow w(cowName);
    Animal *ptr;
    cout << "\n--- Dog Details ---" << endl;
    ptr = &d;
    ptr->display();
    ptr->sound();
    cout << "\n--- Cat Details ---" << endl;
    ptr = &c;
    ptr->display();
    ptr->sound();
    cout << "\n--- Cow Details ---" << endl;
    ptr = &w;
    ptr->display();
    ptr->sound();
    return 0;
}
